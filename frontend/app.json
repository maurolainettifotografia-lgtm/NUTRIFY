{
  "expo": {
    "name": "Nutrify",
    "slug": "nutrify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maurolainetti.nutrify",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografar alimentos para análise nutricional",
        "NSPhotoLibraryUsageDescription": "Selecionar fotos de alimentos da galeria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.maurolainetti.nutrify",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Fotografar alimentos para análise nutricional"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos de alimentos da galeria"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
