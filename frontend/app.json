{
  "expo": {
    "name": "Nutrify",
    "slug": "nutrify",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon-nutrify.png",
    "scheme": "nutrify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.maurolainetti.nutrify",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografar alimentos para anÃƒÆ’Ã‚Â¡lise nutricional",
        "NSPhotoLibraryUsageDescription": "Selecionar fotos de alimentos da galeria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#0D0F12",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "package": "com.maurolainetti.nutrify",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon-nutrify.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-nutrify.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F12"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Fotografar alimentos para anÃƒÆ’Ã‚Â¡lise nutricional"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos de alimentos da galeria"
        }
      ],
      "expo-apple-authentication",
      "./plugins/with-local-api"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
